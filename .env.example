# ---------------------------------------------------------------------------
# Privy App ID — wallet connect (get one at https://dashboard.privy.io)
# Set in Vercel → Settings → Environment Variables (name must start with NEXT_PUBLIC_).
# If empty, the site falls back to injected-wallet / sim connect so it still builds.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_PRIVY_APP_ID=

# ---------------------------------------------------------------------------
# UNIA's brain — Bankr LLM Gateway (https://docs.bankr.bot , key: bankr.bot/api-keys)
# Server-side only (NOT NEXT_PUBLIC) so the key never reaches the browser.
# If BANKR_API_KEY is empty, chat replies fall back to a canned in-character line.
# ---------------------------------------------------------------------------
BANKR_API_KEY=
# Model id the gateway supports (Claude / GPT / Gemini / Grok — check Bankr docs).
BANKR_MODEL=gpt-4o-mini
# Override only if Bankr changes the base URL.
BANKR_BASE_URL=https://llm.bankr.bot/v1
